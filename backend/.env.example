PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
# Leave DATABASE_URL empty or comment it out to use the built-in local PostgreSQL engine.
# Or provide a full connection string: postgres://postgres:postgres@localhost:5432/kelodb
DATABASE_URL=

# Admin Authentication
# Change this in production! The hash will be automatically generated if not set.
ADMIN_DEFAULT_PASSWORD=admin_kelo_secure_2026!
JWT_SECRET=kelo_super_secret_jwt_key_2026_postgre_secure
JWT_EXPIRES_IN=8h

# Optional Groq API Key for AI Assistant (falls back to smart heuristic if not set)
GROQ_API_KEY=
